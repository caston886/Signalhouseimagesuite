<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SignalHouse.App.Views.Controls.ColorAdjustmentPanel">

  <UserControl.Styles>
    <Style Selector="TextBlock.SectionHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,4" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Grid.SliderRow">
      <Setter Property="Margin" Value="0,2" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="12" Spacing="2">

      <TextBlock Classes="SectionHeader" Text="Tone" />

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Exposure" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-5" Maximum="5" Value="{Binding Exposure}" />
        <TextBlock Grid.Column="2" Text="{Binding Exposure, StringFormat={}{0:0.00}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Contrast" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
        <TextBlock Grid.Column="2" Text="{Binding Contrast, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Saturation" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Saturation}" />
        <TextBlock Grid.Column="2" Text="{Binding Saturation, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <TextBlock Classes="SectionHeader" Text="White Balance" />

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Temperature" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="2000" Maximum="12000" Value="{Binding WhiteBalanceTemperature}" />
        <TextBlock Grid.Column="2" Text="{Binding WhiteBalanceTemperature, StringFormat={}{0:0}K}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Tint" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding WhiteBalanceTint}" />
        <TextBlock Grid.Column="2" Text="{Binding WhiteBalanceTint, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <TextBlock Classes="SectionHeader" Text="Color Balance" />

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Cyan — Red" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding CyanRed}" />
        <TextBlock Grid.Column="2" Text="{Binding CyanRed, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Magenta — Green" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding MagentaGreen}" />
        <TextBlock Grid.Column="2" Text="{Binding MagentaGreen, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Yellow — Blue" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding YellowBlue}" />
        <TextBlock Grid.Column="2" Text="{Binding YellowBlue, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <TextBlock Classes="SectionHeader" Text="Detail" />

      <Grid Classes="SliderRow" ColumnDefinitions="90,*,48">
        <TextBlock Grid.Column="0" Text="Clarity" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Clarity}" />
        <TextBlock Grid.Column="2" Text="{Binding Clarity, StringFormat={}{0:0}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>

      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,14,0,0">
        <Button Content="Undo" Command="{Binding UndoCommand}" />
        <Button Content="Redo" Command="{Binding RedoCommand}" />
        <Button Content="Commit Edit (Tab)" Command="{Binding CommitEditCommand}" />
        <Button Content="Reset" Command="{Binding ResetAdjustmentsCommand}" />
      </StackPanel>

      <TextBlock Classes="SectionHeader" Text="Templates" />

      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Watermark="Template name" Text="{Binding NewPresetName}" Width="160" />
        <Button Content="Save as Template" Command="{Binding SaveAsPresetCommand}" />
      </StackPanel>

      <ListBox ItemsSource="{Binding Presets}"
               SelectedItem="{Binding SelectedPreset}"
               Height="160"
               Margin="0,6,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto,Auto">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                <TextBlock Text="{Binding SourceEditor}" FontSize="11" Opacity="0.6" />
              </StackPanel>
              <Button Grid.Column="1" Content="Apply"
                      Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" Margin="4,0" />
              <Button Grid.Column="2" Content="Delete"
                      Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                      CommandParameter="{Binding}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{Binding StatusMessage}"
                 Margin="0,10,0,0"
                 Opacity="0.75"
                 TextWrapping="Wrap" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
